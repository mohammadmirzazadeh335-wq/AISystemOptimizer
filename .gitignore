# Build output
bin/
obj/
dist/
publish/
*.user
*.suo
.vs/

# Test results
TestResults/
*.trx
*.coverage

# Portable / runtime data (created next to the executable in portable mode)
Logs/
Backups/
Reports/
Cache/
optimization_history.json
config.local.json

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# NuGet
*.nupkg
packages/

# Don't ignore SmartLocker final deliverables - these ARE the product
!SmartLocker/dist/
!SmartLocker/dist/*
!CAD_Output/

# SmartLocker temp build (ignore temp)
SmartLocker_Out_Sample/
SmartLocker/API_Generator/src/SmartLockerGenerator/bin/
SmartLocker/API_Generator/src/SmartLockerGenerator/obj/
SmartLocker/CAD_Output_prev/

# The portable build is published as a GitHub release asset (see README → Download).
# It is a 66 MB self-contained binary; committing it would bloat every clone.
portable/*.exe
portable/*.pdb
