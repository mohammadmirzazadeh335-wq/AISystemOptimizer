<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <AssemblyName>ServerHelp</AssemblyName>
    <RootNamespace>ServerHelp</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Server Help</Product>
    <AssemblyTitle>Server Help</AssemblyTitle>
    <Description>Minecraft server helper: network tunnel, DNS and system optimisation for low-ping play.</Description>
    <Company>ServerHelp</Company>
    <Copyright>ServerHelp</Copyright>
    <NeutralLanguage>fa</NeutralLanguage>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0169;CS0414;CS0649;CS1591</NoWarn>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-only: lets net48 build on any machine/CI runner without a targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Bundled helper binaries. The release workflow drops them here before building; without
       them the app still builds and can fetch them at runtime. -->
  <ItemGroup Condition="Exists('vendor\sing-box.exe')">
    <EmbeddedResource Include="vendor\sing-box.exe" LogicalName="ServerHelp.bin.sing-box.exe" />
  </ItemGroup>
  <ItemGroup Condition="Exists('vendor\wintun.dll')">
    <EmbeddedResource Include="vendor\wintun.dll" LogicalName="ServerHelp.bin.wintun.dll" />
  </ItemGroup>

</Project>
