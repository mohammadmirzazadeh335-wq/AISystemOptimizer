<UserControl x:Class="AISystemOptimizer.UI.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AISystemOptimizer.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:RiskLevelToBrushConverter x:Key="RiskToBrush"/>
        <conv:RiskLevelToTextConverter x:Key="RiskToText"/>
        <conv:ProcessCategoryToTextConverter x:Key="CategoryToText"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <conv:SignatureStatusToTextConverter x:Key="SignatureToText"/>
        <conv:BytesToReadableConverter x:Key="BytesToReadable"/>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Processes" Style="{StaticResource PageTitleStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="  \u2022  " Foreground="{DynamicResource TertiaryTextBrush}"/>
                    <TextBlock Text="{Binding ListedMemoryText}" Foreground="{DynamicResource TertiaryTextBrush}"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource FluentTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by name, path or publisher"/>

                <ComboBox Grid.Column="1"
                          Width="140" Margin="8,0,0,0"
                          Style="{StaticResource FluentComboBoxStyle}"
                          ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding CategoryFilter}"/>

                <ComboBox Grid.Column="2"
                          Width="120" Margin="8,0,0,0"
                          Style="{StaticResource FluentComboBoxStyle}"
                          ItemsSource="{Binding SortColumns}"
                          SelectedItem="{Binding SortColumn}"/>

                <CheckBox Grid.Column="3"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Content="Only safe to close"
                          Foreground="{DynamicResource WindowForegroundBrush}"
                          IsChecked="{Binding ShowOnlyOptimizable}"/>

                <Button Grid.Column="4"
                        Margin="12,0,0,0"
                        Content="Clear"
                        Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding ClearFiltersCommand}"/>
            </Grid>
        </Border>

        <!-- Table + details -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="4" Margin="0,0,8,0">
                <DataGrid Style="{StaticResource FluentDataGridStyle}"
                          ItemsSource="{Binding FilteredProcesses}"
                          SelectedItem="{Binding SelectedProcess}"
                          VirtualizingPanel.IsVirtualizing="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Width="*"
                                            Binding="{Binding DisplayName}"/>
                        <DataGridTextColumn Header="Category" Width="110"
                                            Binding="{Binding Category, Converter={StaticResource CategoryToText}}"/>
                        <DataGridTextColumn Header="RAM" Width="90"
                                            Binding="{Binding FormattedWorkingSet}"/>
                        <DataGridTextColumn Header="CPU" Width="70"
                                            Binding="{Binding FormattedCpuUsage}"/>
                        <DataGridTextColumn Header="PID" Width="70"
                                            Binding="{Binding Id}"/>
                        <DataGridTemplateColumn Header="Risk" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Fill="{Binding RiskLevel, Converter={StaticResource RiskToBrush}}"/>
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding RiskLevel}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Details pane -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PROCESS DETAILS" Style="{StaticResource CaptionTextStyle}"/>

                        <TextBlock Text="Select a process on the left."
                                   Margin="0,10,0,0"
                                   Style="{StaticResource CardBodyTextStyle}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SelectedProcess.DisplayName}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource CardTitleBrush}"/>
                            <TextBlock Text="{Binding SelectedProcess.Name}"
                                       Style="{StaticResource CaptionTextStyle}"/>

                            <Border Margin="0,10,0,0" Padding="8" CornerRadius="4"
                                    Background="{Binding SelectedProcess.RiskLevel, Converter={StaticResource RiskToBrush}}">
                                <TextBlock Text="{Binding SelectedProcess.RiskLevel, Converter={StaticResource RiskToText}}"
                                           Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProcess.Id}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProcess.FormattedWorkingSet}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProcess.FormattedCpuUsage}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Category" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProcess.Category, Converter={StaticResource CategoryToText}}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Publisher" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProcess.Publisher}" TextWrapping="Wrap" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Signature" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProcess.SignatureStatus, Converter={StaticResource SignatureToText}}" TextWrapping="Wrap" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Parent process" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProcess.ParentProcessName}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Started" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedProcess.FormattedStartTime}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Running for" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProcess.FormattedRunningTime}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Threads / handles" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource CardBodyTextStyle}">
                                    <Run Text="{Binding SelectedProcess.ThreadCount, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding SelectedProcess.HandleCount, Mode=OneWay}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Session" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedProcess.SessionId}" Style="{StaticResource CardBodyTextStyle}"/>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="Path" Style="{StaticResource CaptionTextStyle}"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding SelectedProcess.Path}" TextWrapping="Wrap" Style="{StaticResource CardBodyTextStyle}"/>
                            </Grid>

                            <TextBlock Text="Unsigned does not mean unsafe: many legitimate tools ship without a  code-signing certificate. Review the path above before drawing conclusions."
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TertiaryTextBrush}"/>

                            <!-- Classification explanation -->
                            <Border Margin="0,12,0,0" Padding="10" CornerRadius="4"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                <TextBlock Text="{Binding ClassificationNote}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CardBodyTextStyle}"/>
                            </Border>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Close process"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding CloseProcessCommand}"
                                        ToolTip="{Binding CloseButtonTooltip}"/>
                                <Button Content="Explain (AI)"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExplainCommand}"
                                        ToolTip="Only available when a local AI model is configured and reachable."/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Never close this"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding WhitelistCommand}"
                                        ToolTip="Adds the process to the whitelist - it will never be closed automatically."/>
                                <Button Content="Never touch this"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Command="{Binding BlacklistCommand}"
                                        ToolTip="Adds the process to the protected list."/>
                            </StackPanel>

                            <Border Margin="0,12,0,0" Padding="10" CornerRadius="4"
                                    Background="{DynamicResource NavigationSelectedBrush}"
                                    Visibility="{Binding AiExplanation, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding AiExplanation}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CardBodyTextStyle}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
