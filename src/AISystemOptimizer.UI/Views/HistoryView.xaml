<UserControl x:Class="AISystemOptimizer.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AISystemOptimizer.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="960">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="History &amp; Reports" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="{Binding SummaryText}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Create restore point" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding CreateRestorePointCommand}"/>
                <Button Content="Undo last" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding UndoSelectedCommand}"/>
                <Button Content="Backups" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding OpenBackupsCommand}"/>
                <Button Content="Export report" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding ExportReportCommand}"/>
                <Button Content="Clear history" Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding ClearHistoryCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="4" Margin="0,0,8,0">
                <DataGrid Style="{StaticResource FluentDataGridStyle}"
                          ItemsSource="{Binding Sessions}"
                          SelectedItem="{Binding SelectedSession}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Width="*" Binding="{Binding FormattedTimestamp}"/>
                        <DataGridTextColumn Header="RAM before" Width="100"
                                            Binding="{Binding BeforeRamUsage, StringFormat={}{0:F1}%}"/>
                        <DataGridTextColumn Header="RAM after" Width="100"
                                            Binding="{Binding AfterRamUsage, StringFormat={}{0:F1}%}"/>
                        <DataGridTextColumn Header="Actions" Width="80"
                                            Binding="{Binding Plan.TotalActionCount}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SESSION DETAILS" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedSummary}" Margin="0,10,0,0"
                               TextWrapping="Wrap" Style="{StaticResource CardBodyTextStyle}"/>

                    <TextBlock DockPanel.Dock="Top" Text="FULL REPORT" Margin="0,16,0,6"
                               Style="{StaticResource CaptionTextStyle}"/>

                    <TextBox Text="{Binding ReportText, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, Courier New"
                             FontSize="12"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource WindowForegroundBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
