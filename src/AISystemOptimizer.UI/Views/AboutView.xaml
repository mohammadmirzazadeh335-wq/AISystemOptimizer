<UserControl x:Class="AISystemOptimizer.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AISystemOptimizer.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="980">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource FluentScrollViewerStyle}">
        <StackPanel Margin="20,16,20,24">

            <TextBlock Text="{Binding AppName}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Margin="0,4,0,0">
                <Run Text="Version "/>
                <Run Text="{Binding AppVersion, Mode=OneWay}"/>
                <Run Text="  •  "/>
                <Run Text="{Binding Framework, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding AppDescription}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBlock Text="{Binding Elevation}" Margin="0,6,0,0"
                       Foreground="{DynamicResource TertiaryTextBrush}"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="WHAT IT DOES" Style="{StaticResource CaptionTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding DoesDo}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="&#x2713;" Foreground="{StaticResource RiskLowBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Style="{StaticResource CardBodyTextStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="WHAT IT NEVER DOES" Style="{StaticResource CaptionTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding NeverDoes}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <TextBlock Text="&#x2715;" Foreground="{StaticResource RiskCriticalBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                   Style="{StaticResource CardBodyTextStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CAPABILITIES ON THIS MACHINE" Style="{StaticResource CaptionTextStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Run diagnostics" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding RunDiagnosticsCommand}"/>
                            <Button Content="Copy" Margin="10,0,0,0" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding CopyDiagnosticsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource CardBodyTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource CardBodyTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Note}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               Text="Where a sensor or counter is unavailable the application reports N/A instead of inventing a plausible value."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                    Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource CaptionTextStyle}"/>
                    <TextBox Text="{Binding Diagnostics, Mode=OneWay}" Margin="0,10,0,0"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             MinHeight="200" MaxHeight="320"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                             Background="{DynamicResource ControlBackgroundBrush}"
                             Foreground="{DynamicResource WindowForegroundBrush}"
                             BorderBrush="{DynamicResource ControlBorderBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Open log folder" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding OpenLogFolderCommand}"/>
                <Button Content="Project website" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding OpenWebsiteCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
