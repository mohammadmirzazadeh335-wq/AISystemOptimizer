<!--
    AI System Optimizer - Light theme
    ==================================
    Same keys as DarkTheme.xaml, light Fluent values.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFE9E9E9"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="NavigationPaneBackgroundBrush" Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="NavigationSectionTitleBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#220F6CBD"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE2E2E2"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="CardForegroundBrush" Color="#FF4C4C4C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE2E2E2"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF4C4C4C"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF767676"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFCFCFCF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FFEBEBEB"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FFE2E2E2"/>
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FFFFFFFF"/>

</ResourceDictionary>
