<!--
    AI System Optimizer - Dark theme
    =================================
    Overrides the theme brush keys declared in FluentDesign.xaml.
    This is the default theme (Windows 11 dark Fluent palette).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF202020"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="NavigationPaneBackgroundBrush" Color="#FF272727"/>
    <SolidColorBrush x:Key="NavigationSectionTitleBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="NavigationHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="NavigationSelectedBrush" Color="#330F6CBD"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF2D2D2D"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF3D3D3D"/>
    <SolidColorBrush x:Key="CardTitleBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="CardForegroundBrush" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF3D3D3D"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFC8C8C8"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF4A4A4A"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF383838"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF444444"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FF3D3D3D"/>
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FF2D2D2D"/>

</ResourceDictionary>
