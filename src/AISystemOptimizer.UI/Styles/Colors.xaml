<!--
    AI System Optimizer - Colour palette
    ====================================
    A Fluent-inspired palette. Every brush used by the app is defined here so that
    switching between the dark and light theme only requires swapping this file.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== Accent ==================== -->
    <Color x:Key="AccentColor">#FF0F6CBD</Color>
    <Color x:Key="AccentColorLight">#FF2B88D8</Color>
    <Color x:Key="AccentColorDark">#FF0B5394</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentColorLight}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentColorDark}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>

    <!-- ==================== Risk colours (fixed, never themed) ==================== -->
    <SolidColorBrush x:Key="RiskLowBrush" Color="#FF107C10"/>
    <SolidColorBrush x:Key="RiskMediumBrush" Color="#FFF7A501"/>
    <SolidColorBrush x:Key="RiskHighBrush" Color="#FFD83B01"/>
    <SolidColorBrush x:Key="RiskCriticalBrush" Color="#FFC42B1C"/>

    <SolidColorBrush x:Key="RiskLowBackgroundBrush" Color="#26107C10"/>
    <SolidColorBrush x:Key="RiskMediumBackgroundBrush" Color="#26F7A501"/>
    <SolidColorBrush x:Key="RiskHighBackgroundBrush" Color="#26D83B01"/>
    <SolidColorBrush x:Key="RiskCriticalBackgroundBrush" Color="#26C42B1C"/>

    <!-- ==================== Metric colours ==================== -->
    <SolidColorBrush x:Key="RamBrush" Color="#FF744DA9"/>
    <SolidColorBrush x:Key="CpuBrush" Color="#FF0F6CBD"/>
    <SolidColorBrush x:Key="GpuBrush" Color="#FF00838F"/>
    <SolidColorBrush x:Key="DiskBrush" Color="#FFCA5010"/>
    <SolidColorBrush x:Key="NetworkBrush" Color="#FF107C10"/>

    <!-- ==================== Semantic ==================== -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C10"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF7A501"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#FF0F6CBD"/>

    <!-- ==================== Dark theme surfaces ==================== -->
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="DarkCardBrush" Color="#FF323232"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="#FF3F3F3F"/>
    <SolidColorBrush x:Key="DarkTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DarkSecondaryTextBrush" Color="#FFC5C5C5"/>
    <SolidColorBrush x:Key="DarkTertiaryTextBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="DarkNavigationBrush" Color="#FF272727"/>
    <SolidColorBrush x:Key="DarkTitleBarBrush" Color="#FF272727"/>

    <!-- ==================== Light theme surfaces ==================== -->
    <SolidColorBrush x:Key="LightBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="LightSurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LightCardBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="LightBorderBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="LightTextBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="LightSecondaryTextBrush" Color="#FF5C5C5C"/>
    <SolidColorBrush x:Key="LightTertiaryTextBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="LightNavigationBrush" Color="#FFEAEAEA"/>
    <SolidColorBrush x:Key="LightTitleBarBrush" Color="#FFF3F3F3"/>

</ResourceDictionary>
